# Copy from .env.example, fill values, save as .env (gitignored).
# Loaded automatically on startup; IntelliJ env vars override .env.

SPRING_PROFILES_ACTIVE=dev

# Supabase → Project Settings → Database → Connection string (URI) → JDBC
# Direct:  jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require&connectTimeout=10&socketTimeout=30
# Pooler:  jdbc:postgresql://aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require&connectTimeout=10&socketTimeout=30
SPRING_DATASOURCE_URL=
DB_USERNAME=postgres
DB_PASSWORD=

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
SUPABASE_JWKS_URI=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_SERVICE_ROLE_KEY=

FRONTEND_URL=http://localhost:5173
CONSUMER_FRONTEND_URL=http://localhost:5174

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

RESEND_API_KEY=
RESEND_FROM_EMAIL=

GEMINI_API_KEY=
